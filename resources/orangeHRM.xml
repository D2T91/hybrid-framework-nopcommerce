<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >

<suite name="OrangeHRM UI Automation" verbose="1" >

    <listeners>
        <listener class-name="commons.MethodListener"></listener>
    </listeners>

    <parameter name="url" value="http://localhost/orangehrm-5.7/web/index.php/auth/login"></parameter>

    <test name="Run on Firefox browser" >
        <parameter name="browser" value="firefox"></parameter>
        <classes>
            <class name="com.orangehrm.pim.PIM_01_Employee" />
        </classes>
    </test>

    <test name="Run on Chrome browser" >
        <parameter name="browser" value="chrome"></parameter>
        <classes>
            <class name="com.orangehrm.pim.PIM_01_Employee" />
        </classes>
    </test>

    <test name="Run on Edge browser" >
        <parameter name="browser" value="edge"></parameter>
        <classes>
            <class name="com.orangehrm.pim.PIM_01_Employee" />
        </classes>
    </test>

</suite>
