<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >

<suite name="OrangeHRM UI Automation" verbose="1" >

    <parameter name="url" value="https://opensource-demo.orangehrmlive.com/"></parameter>
    <parameter name="server" value="dev"></parameter>

    <test name="Run on Edge browser" >
        <parameter name="browser" value="edge"></parameter>
        <classes>
            <class name="com.orangehrm.employee.Level_04_Multiple_Browser" />
        </classes>
    </test>

    <test name="Run on Firefox browser" >
        <parameter name="browser" value="fireFox"></parameter>
        <classes>
            <class name="com.orangehrm.employee.Level_04_Multiple_Browser" />
        </classes>
    </test>

    <test name="Run on Chrome browser" >
        <parameter name="browser" value="chrome"></parameter>
        <classes>
            <class name="com.orangehrm.employee.Level_04_Multiple_Browser" />
        </classes>
    </test>

</suite>
